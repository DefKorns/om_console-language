# leftovers from the CompCom Options Menu releases (RC4 and b135/b136)
rm -f "$rootfs/etc/preinit.d/p8020_shonen_hack" "$rootfs/etc/preinit.d/p8024_zlanguage"
rm -f "$rootfs/etc/options_menu/commands/c0090_Shonen" "$rootfs/etc/options_menu/commands/c0090_Languages"
rm -f "$rootfs/etc/options_menu/commands/c0079_ConsoleLanguage"
rm -f "$rootfs/etc/options_menu/scripts/om_languagemod" "$rootfs/etc/options_menu/scripts/om_languagemod.txt"
rm -rf "$rootfs/etc/options_menu/shonen" "$rootfs/etc/options_menu/languages" "$rootfs/etc/options_menu/localization"
for bin in nes snes; do
  if [ -f "$rootfs/${bin}_backup" ]; then
    cp -f "$rootfs/${bin}_backup" "$rootfs/bin/$bin"
    rm -f "$rootfs/${bin}_backup"
  fi
done

# om-language-hack state, copied before its uninstall wipes the folder;
# patches state is kept for OM Game Translations
cl_old="$rootfs/etc/options_menu/language_hack"
if [ -d "$cl_old" ]; then
  cl_new="$rootfs/etc/options_menu/console_language"
  gt_new="$rootfs/etc/options_menu/game_translations"
  mkdir -p "$cl_new/commands" "$gt_new"
  for f in "$cl_old"/active.* "$cl_old"/custom "$cl_old"/images; do
    [ -e "$f" ] && cp -rf "$f" "$cl_new/"
  done
  for f in "$cl_old"/patches.* "$cl_old"/patches_ips; do
    [ -e "$f" ] && cp -rf "$f" "$gt_new/"
  done
fi
for cl_unfile in "$installpath/hmod/uninstall-om-language-hack"* \
                 "$installpath/hmod/uninstall-OM_Shonen_Language-Hack"*; do
  [ -f "$cl_unfile" ] && pack_uninstall "${cl_unfile##*/uninstall-}"
done

# the boot script lives in the addon folder and is copied over only while a language is applied
rm -f "$rootfs/etc/preinit.d/b8020_console_language" "$rootfs/etc/preinit.d/p8020_console_language"

# earlier layouts of the language screen
cl_cmds_old="$rootfs/etc/options_menu/console_language/commands"
rm -f "$cl_cmds_old"/c000[0-7]_* "$cl_cmds_old"/_c000[0-7]_* "$cl_cmds_old"/c01[0-9][0-9]_* "$cl_cmds_old"/c88[0-9][0-9]_* "$cl_cmds_old"/_c88[0-9][0-9]_*
# the entry sits first in the Language screen now; its separator is shared with the other language addons
rm -f "$rootfs/etc/options_menu/language/commands/c9010_ConsoleLanguage"
ls "$rootfs/etc/options_menu/language/commands/"c90[1-9]* >/dev/null 2>&1 ||
  rm -f "$rootfs/etc/options_menu/language/commands/c9000_separator"

# the title font comes from Font Remount now
rm -f "$rootfs/etc/options_menu/console_language/assets/fonts/title.fnt" "$rootfs/etc/options_menu/console_language/assets/desktop"/*/title.fnt
rm -rf "$rootfs/etc/options_menu/console_language/gamefont"

# custom/<code> to custom/<system>/<code>: the files' layout tells which firmware downloaded it
cl_custom="$rootfs/etc/options_menu/console_language/custom"
for cl_lang in "$cl_custom"/*; do
  cl_code="${cl_lang##*/}"
  case "$cl_code" in nes | shonen | snes) continue ;; esac
  if [ -f "$cl_lang/strings.lng" ]; then
    cl_sys=shonen
  elif ls "$cl_lang"/strings/*/strings.json >/dev/null 2>&1; then
    cl_sys=nes
  elif ls "$cl_lang"/strings/*/strings.lng >/dev/null 2>&1; then
    cl_sys=snes
  else
    continue
  fi
  [ -e "$cl_custom/$cl_sys/$cl_code" ] && continue
  mkdir -p "$cl_custom/$cl_sys"
  mv "$cl_lang" "$cl_custom/$cl_sys/$cl_code"
  case "$cl_code" in
  as_id) cl_name="Bahasa Indonesia" ;;
  cst_cw) cl_name="Spurdo" ;;
  eur_gr) cl_name="Ellinika" ;;
  eur_nor) cl_name="Norsk" ;;
  eur_swe) cl_name="Svenska" ;;
  por_br) cl_name="Português (Brasil)" ;;
  *) cl_name="$cl_code" ;;
  esac
  echo "$cl_name" >"$cl_custom/$cl_sys/$cl_code/name"
done

transfer_default

if ls "$rootfs/etc/options_menu/console_language"/active.* >/dev/null 2>&1; then
  cp -f "$rootfs/etc/options_menu/console_language/preinit/p8020_console_language" "$rootfs/etc/preinit.d/p8020_console_language"
fi
return 1

# The rōmaji overlay goes on the games folder the UI reads, where the sync of Hakchi unmounts it.
# cl_plain skips it for a plain bind.
bind_games() {
  local cl_lib="$rootfs/etc/options_menu/console_language/scripts/cl_functions"
  [ -z "$gamepath" ] && return 0
  if [ -z "$cl_plain" ] && [ -f "$cl_lib" ]; then
    source "$cl_lib"
    clInit
    clBindGames "$1" "$2" || mount_bind "$1" "$2" || return 1
  else
    mount_bind "$1" "$2" || return 1
  fi
  repair_fonts "$1"
}

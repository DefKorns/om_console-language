source $mountpoint/etc/options_menu/console_language/scripts/cl_vars

# one pass: the entries a console can't use are parked as _<name>, which the menu ignores
clShow() {
  local name
  for name in "$@"; do
    [ -f "$cl_cmds/_$name" ] && mv "$cl_cmds/_$name" "$cl_cmds/$name"
  done
}

clHide() {
  local name
  for name in "$@"; do
    [ -f "$cl_cmds/$name" ] && mv "$cl_cmds/$name" "$cl_cmds/_$name"
  done
}

cl_builtin_names="c0100_usa_en c0101_eur_de c0102_eur_es c0103_eur_fr c0104_eur_it c0105_eur_nl c0106_eur_pt c0107_eur_ru"

# the hidden languages, "Revert to Japanese" and the Rōmaji titles only exist on the Japanese firmwares
case "$cl_system" in
shonen | hvc | shvc)
  clShow $cl_builtin_names c0020_Revert
  clHide c0021_Restore
  if [ -f "$cl_home/active.$cl_system" ]; then
    clShow c0030_Romaji
  else
    clHide c0030_Romaji
  fi
  ;;
*)
  clHide $cl_builtin_names c0020_Revert c0030_Romaji
  clShow c0021_Restore
  ;;
esac

if hasInternet; then
  clShow c0010_Download
else
  clHide c0010_Download
fi

clMenuEntries

usleep 50000 && "$options_menu/options" --commandPath "$cl_cmds/" --scriptPath "$cl_home/scripts" --title "CL_TITLE" --selectedMarker "$cl_home/active.$cl_system" &

source $mountpoint/etc/options_menu/console_language/scripts/cl_vars

# the hidden languages and "Revert to Japanese" only exist on the Japanese firmwares
case "$system" in
shonen | hvc | shvc)
  for cmd in "$cl_cmds"/_c000[0-7]_*; do
    rename "$cmd" "$cl_cmds/${cmd##*/_}"
  done
  enableCmds "revert"
  disableCmds "restore"
  ;;
*)
  for cmd in "$cl_cmds"/c000[0-7]_*; do
    rename "$cmd" "$cl_cmds/_${cmd##*/}"
  done
  disableCmds "revert"
  enableCmds "restore"
  ;;
esac
toggleDownloads

cl_menu_entries

usleep 50000 && "$options_menu/options" --commandPath "$cl_cmds/" --scriptPath "$cl_home/scripts" --title "CL_TITLE" --selectedMarker "$cl_home/active.$cl_system" &

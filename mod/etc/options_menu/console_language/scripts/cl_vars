# shellcheck source=/dev/null
source $mountpoint/etc/options_menu/scripts/om_functions
cl_init

# writes go through "/" ($cl_home); the preinit reads the same files from $rootfs ($cl_dir)
cl_home="$options_menu/console_language"
cl_cmds="$cl_home/commands"
cl_url="https://github.com/DefKorns/om_console-language/releases/download/languages-v1"

# one entry per language installed for this firmware, by the download entry or a language hmod
cl_menu_entries() {
  local lang code cmd n=100
  rm -f "$cl_cmds/"c01[0-9][0-9]_*
  for lang in "$cl_home/custom/$cl_pack"/*; do
    [ -f "$lang/name" ] || continue
    code="${lang##*/}"
    cmd="$cl_cmds/c0${n}_$code"
    printf '%s\n' \
      "COMMAND_NAME=$(cat "$lang/name")" \
      "COMMAND_TYPE=INTERNAL" \
      "COMMAND_STR=sh %script_dir%/console_language.sh apply $code" >"$cmd"
    [ -f "$cl_home/images/$code.png" ] && echo "PREVIEW_IMAGE=/etc/options_menu/console_language/images/$code.png" >>"$cmd"
    n=$((n + 1))
  done
}

enable_downloads="$cl_cmds/c8888_Download"
disable_downloads="$cl_cmds/_c8888_Download"
enable_revert="$cl_cmds/c8890_Revert"
disable_revert="$cl_cmds/_c8890_Revert"
enable_restore="$cl_cmds/c8891_Restore"
disable_restore="$cl_cmds/_c8891_Restore"

lh_preinit="$rootfs/etc/preinit.d/p8020_language_hack"
if [ -f "$lh_preinit" ]; then
  lh_lib=1
  . "$lh_preinit"
  lh_init
  lh_umount_lang
  lh_umount_patches
fi

rm -f "$lh_preinit"
rm -f "$rootfs/etc/options_menu/commands/c0079_ConsoleLanguage"
rm -rf "$rootfs/etc/options_menu/language_hack"

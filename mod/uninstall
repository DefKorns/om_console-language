del() {
  rm -rf "$@"
}

om_path="$rootfs/etc/options_menu"
cl_path="$om_path/console_language"
lang_cmds="$om_path/language/commands"
pre_initd="$rootfs/etc/preinit.d"

if [ -f "$cl_path/scripts/cl_functions" ]; then
  source "$cl_path/scripts/cl_functions"
  clInit
  clUmountLang
  clUmountRomaji
fi

del "$pre_initd/b8020_console_language" "$pre_initd/p8020_console_language"
del "$lang_cmds/c0001_ConsoleLanguage" "$lang_cmds/c9010_ConsoleLanguage"
# the separator is shared with the other language addons
ls "$lang_cmds"/c000[1-9]_[!s]* >/dev/null 2>&1 || del "$lang_cmds/c0002_separator"
del "$cl_path"
